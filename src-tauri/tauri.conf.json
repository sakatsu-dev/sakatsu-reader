{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sakatsu Reader",
  "version": "1.0.1",
  "identifier": "com.sakatsu.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && python scripts/prepare-essentials.py --verify"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sakatsu Reader",
        "width": 900,
        "height": 640,
        "minWidth": 480,
        "minHeight": 520,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' blob:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 the Sakatsu contributors",
    "resources": {
      "resources/essentials/": "essentials/",
      "../scripts/fetch-dictionaries.ps1": "scripts/fetch-dictionaries.ps1",
      "../scripts/fetch-frequency-bccwj.ps1": "scripts/fetch-frequency-bccwj.ps1",
      "../scripts/fetch-frequency-jpdb.ps1": "scripts/fetch-frequency-jpdb.ps1",
      "../scripts/fetch-kanjidic.ps1": "scripts/fetch-kanjidic.ps1",
      "../scripts/fetch-ocr-model.ps1": "scripts/fetch-ocr-model.ps1",
      "../scripts/fetch-paddle-ocr.ps1": "scripts/fetch-paddle-ocr.ps1",
      "../scripts/fetch-pronunciation.ps1": "scripts/fetch-pronunciation.ps1",
      "../scripts/fetch-translation-model.ps1": "scripts/fetch-translation-model.ps1",
      "../scripts/fetch-wordnet.ps1": "scripts/fetch-wordnet.ps1",
      "../scripts/setup-ichiran.ps1": "scripts/setup-ichiran.ps1",
      "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../LICENSE": "LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
